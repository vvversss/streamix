{
  "name": "streamix",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -k -n API,WEB \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --watch server/index.js",
    "dev:web": "vite web --host localhost",
    "build": "vite build web",
    "start": "node server/index.js"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@supabase/supabase-js": "2.119.0",
    "cors": "2.8.6",
    "dotenv": "18.0.10",
    "express": "5.3.0",
    "express-rate-limit": "8.7.4",
    "helmet": "8.3.0",
    "hls.js": "1.7.4",
    "lucide-react": "1.72.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "concurrently": "10.0.7",
    "vite": "8.3.8"
  }
}
